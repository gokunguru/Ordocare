# ══════════════════════════════════════════════════════════════════════════════
# OrdoCare — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs.
#  Ne jamais commit un vrai fichier .env
# ══════════════════════════════════════════════════════════════════════════════

# === Django ===
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

# === Encryption (OBLIGATOIRE si django-encrypted-model-fields) ===
# Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=generate-a-valid-32-byte-base64-key 
#garder le = à la fin 

# === Base de données ===
# Laisser vide/commenté pour utiliser SQLite en local.
# Décommenter pour PostgreSQL (déploiement) :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ordocare
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# === JWT ===
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=1

# === CORS ===
# En production, lister les origines autorisées (séparées par des virgules) :
# CORS_ORIGINS=https://ordocare.fr,https://app.ordocare.fr

# === Pagination / Throttling ===
PAGE_SIZE=20
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=5/minute

# === Microservice ML ===
# ML_SERVICE_URL=http://127.0.0.1:8001
# ML_API_KEY=your-ml-api-key

# === OCR (Tesseract) ===
# macOS :   TESSERACT_CMD=/opt/homebrew/bin/tesseract
# Linux :   TESSERACT_CMD=/usr/bin/tesseract
# Docker :  TESSERACT_CMD=/usr/bin/tesseract

# === Logging ===
LOG_LEVEL=INFO