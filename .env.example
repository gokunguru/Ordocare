# OrdoCare — Variables d'environnement Docker
# Copier ce fichier en .env : cp .env.example .env
# Puis remplir les valeurs avant de lancer docker compose up

# Clé API pour le service ML (obligatoire, générer avec: openssl rand -hex 32)
ML_API_KEY=

# Mot de passe PostgreSQL (production uniquement)
DB_PASSWORD=
